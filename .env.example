# 실시간 협업 웹소켓 서버 주소 (기본값: ws://localhost:1234)
VITE_WS_URL=ws://localhost:1234
# 방/권한 관리 REST API 주소 (기본값: http://localhost:3001/api)
VITE_API_URL=http://localhost:3001/api

# --- 서버(백엔드) 환경변수 ---
# JWT 서명 비밀키 (운영에서는 32자 이상의 임의 값으로 반드시 변경! 이 예시 값이면 운영 모드에서 서버가 시작을 거부함)
JWT_SECRET=change-me-in-production
# API 를 부를 수 있는 프론트 주소 (쉼표로 여러 개, 비우면 모두 허용)
# CORS_ORIGIN=http://localhost:5173
# 앞단 프록시 단계 수 (배포 서비스 뒤에서는 보통 1, 로컬에서 직접 받을 때는 비워 둠)
# TRUST_PROXY=1
# 실시간 서버 메시지 하나의 최대 크기 MB (기본값: 16)
# WS_MAX_PAYLOAD_MB=16
# API 서버 포트 (기본값: 3001, npm run api)
API_PORT=3001
# npm start(API + 실시간 한 포트) 의 포트. 배포 서비스가 보통 자동으로 넣어 줌 (기본값: 3001)
# 이때 프론트는 VITE_API_URL=https://<호스트>/api, VITE_WS_URL=wss://<호스트>/ws
# PORT=3001
# 업로드된 사진/첨부 파일 저장 폴더 (기본값: uploads, STORAGE_DRIVER=disk 일 때)
UPLOAD_DIR=uploads

# --- DB (비우면 로컬 SQLite 파일 board.db) ---
# Supabase › Connect › "Session pooler" 주소 (Render 는 IPv6 를 못 써서 Direct connection 은 안 됨)
# DATABASE_URL=postgresql://postgres.<프로젝트ref>:<DB 비밀번호>@aws-0-<지역>.pooler.supabase.com:5432/postgres
# SSL: no-verify(원격 기본, 암호화만) / verify(인증서 검증, DATABASE_CA_CERT 필요) / disable
# DATABASE_SSL=no-verify
# DATABASE_CA_CERT=./prod-ca-2021.crt
# DATABASE_POOL_MAX=5

# --- 파일 저장소 (disk = 서버 디스크, supabase = Supabase Storage 비공개 버킷) ---
# STORAGE_DRIVER=supabase
# SUPABASE_URL=https://<프로젝트ref>.supabase.co
# Settings › API Keys › Secret key (sb_secret_...). 서버에만! 절대 VITE_ 로 시작하는 변수에 넣지 말 것
# SUPABASE_SECRET_KEY=
# SUPABASE_BUCKET=board-files
